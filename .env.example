# ============================================================================
# Olist Medallion Pipeline — environment configuration
# Copy to .env and adjust as needed:   cp .env.example .env
# Then pin the Airflow UID to your host user:   echo "AIRFLOW_UID=$(id -u)" >> .env
# ============================================================================

# ---- Warehouse Postgres (holds bronze / staging / marts schemas) ----------
WAREHOUSE_USER=olist
WAREHOUSE_PASSWORD=olist
WAREHOUSE_DB=olist
# Host port mapped to the warehouse container (container port is always 5432).
# Use a non-default host port to avoid clashing with any local Postgres on 5432.
WAREHOUSE_PORT_HOST=5442

# ---- Airflow metadata Postgres (separate from the warehouse) --------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# ---- Airflow webserver ----------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Host port for the Airflow UI (use non-default to avoid clashing with a local 8080)
AIRFLOW_PORT=8000
# Run Airflow containers as this UID so bind-mounted logs/dags stay writable.
# Set to your host user id:  echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000
# Stable secret so webserver sessions survive restarts (change for anything real)
AIRFLOW_SECRET_KEY=please-change-me

# ---- Metabase BI ----------------------------------------------------------
METABASE_PORT=3000
